# Copy to .env and fill in. .env is gitignored.

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=shop
POSTGRES_PASSWORD=change_me
POSTGRES_DB=sales_agent

# Host port is 5433, not 5432: a local PostgreSQL 18 service already holds 5432
# on this machine. Inside the compose network services still reach it on 5432.
POSTGRES_HOST_PORT=5433

# Used by the mcp-server container. Host "db" is the compose service name.
DATABASE_URL=postgresql://shop:change_me@db:5432/sales_agent

# --- Groq -----------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Service wiring -------------------------------------------------------
MCP_SERVER_PORT=3001
MCP_SERVER_URL=http://mcp-server:3001/mcp
API_PORT=3000
