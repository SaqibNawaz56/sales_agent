# Copy to .env and fill in. .env is gitignored.

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=shop
POSTGRES_PASSWORD=change_me
POSTGRES_DB=sales_agent

# Host port is 5433, not 5432: a local PostgreSQL 18 service already holds 5432
# on this machine. Inside the compose network services still reach it on 5432.
POSTGRES_HOST_PORT=5433

# Used by the mcp-server container. Host "db" is the compose service name.
DATABASE_URL=postgresql://shop:change_me@db:5432/sales_agent

# --- DeepSeek: the agent itself -------------------------------------------
# Every prompt in the system runs on this. Required — the API will not start a
# turn without it. https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# deepseek-v4-pro or deepseek-v4-flash. Both reason by default; the app sends
# reasoning_effort=none because a forced tool_choice — which every prompt here
# relies on — is rejected in thinking mode.
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Groq: dictation only --------------------------------------------------
# DeepSeek publishes no audio endpoint, so the microphone still goes to Groq's
# Whisper. OPTIONAL: leave it blank and dictation is disabled with a message
# under the mic button. Everything else works by typing.
GROQ_API_KEY=
GROQ_TRANSCRIBE_MODEL=whisper-large-v3
# ISO-639-1. Set to ur for a shop that dictates in Urdu.
GROQ_TRANSCRIBE_LANGUAGE=en

# --- Service wiring -------------------------------------------------------
MCP_SERVER_PORT=3001
MCP_SERVER_URL=http://mcp-server:3001/mcp
API_PORT=3000
