// The only Prisma schema in the project. It lives inside mcp-server on purpose:
// no other package declares a Prisma dependency, so the "all database access is
// behind the MCP server" rule is enforced by the dependency graph, not by habit.

generator client {
  provider      = "prisma-client-js"
  // "native" covers local tooling; the musl target is what node:24-alpine runs.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id             Int      @id @default(autoincrement())
  name           String
  // Unique so a typo can never silently create a second "Ali" (risk R2).
  normalizedName String   @unique @map("normalized_name")
  createdAt      DateTime @default(now()) @map("created_at")

  receipts Receipt[]

  @@map("customers")
}

model Product {
  id             Int      @id @default(autoincrement())
  name           String
  normalizedName String   @unique @map("normalized_name")
  unit           String
  currentPrice   Decimal  @map("current_price") @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  saleItems SaleItem[]

  @@map("products")
}

// One confirmed sale: who bought, when, what it came to, and the number written
// on the paper receipt. The line items live in sale_items.
//
// Named for the receipt rather than the sale because that is what a row is to
// the owner — the thing handed over the counter, and the thing reprinted later.
// The child table is still sale_items: renaming it would rewrite a foreign key
// for no gain, and "the items on this sale" is how the code already reads.
model Receipt {
  id          Int      @id @default(autoincrement())
  customerId  Int      @map("customer_id")
  totalAmount Decimal  @map("total_amount") @db.Decimal(12, 2)
  soldAt      DateTime @default(now()) @map("sold_at")

  // What the owner writes on the paper receipt: a counter that restarts at 1
  // each day, so "receipt 3" means the third sale of that date rather than the
  // third sale ever. Stored rather than derived — a receipt number that could
  // be recomputed differently later is not a receipt number.
  //
  // The date is a DATE, not a timestamp, and is the UTC day of soldAt. That
  // matches how query_daily_total buckets a day, so "receipt 3 of 10 August"
  // and "what did I sell on 10 August" can never disagree about which sales
  // belong to which day.
  receiptDate DateTime @map("receipt_date") @db.Date
  receiptNo   Int      @map("receipt_no")

  customer Customer   @relation(fields: [customerId], references: [id])
  items    SaleItem[]

  // The backstop for two sales confirmed in the same instant. save_sale reads
  // the day's highest number and adds one, which is a read-then-write and can
  // race; this constraint turns that race into a failed write the owner is told
  // about rather than two sales silently sharing a receipt number.
  @@unique([receiptDate, receiptNo])
  @@index([soldAt])
  @@index([customerId])
  @@map("receipts")
}

model SaleItem {
  id        Int     @id @default(autoincrement())
  saleId    Int     @map("sale_id")
  productId Int     @map("product_id")
  quantity  Decimal @db.Decimal(10, 3)

  // Copied from products.current_price at sale time and never re-read. A later
  // catalogue price change must not rewrite what this sale actually charged.
  unitPriceSnapshot Decimal @map("unit_price_snapshot") @db.Decimal(12, 2)
  lineTotal         Decimal @map("line_total") @db.Decimal(12, 2)

  // The scalar stays saleId/sale_id: only the parent table was renamed, so
  // renaming this column would mean rewriting a foreign key to no purpose.
  receipt Receipt @relation(fields: [saleId], references: [id], onDelete: Cascade)
  // Deliberately not cascading: a product must not be deletable out from under
  // the sales that reference it.
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

// Observability sidecar. No relations to the business tables by design.
model ToolCallLog {
  id         Int      @id @default(autoincrement())
  toolName   String   @map("tool_name")
  arguments  Json
  status     String
  durationMs Int?     @map("duration_ms")
  calledAt   DateTime @default(now()) @map("called_at")

  @@index([calledAt])
  @@index([toolName])
  @@map("tool_call_logs")
}
